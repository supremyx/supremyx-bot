# ════════════════════════════════════════════════════════════════════
#  SUPREMYX Bot — Variables d'environnement
#  Copie ce fichier en .env et remplis les valeurs
#  Sur Wispbyte/Railway : configure ces variables dans le panel
# ════════════════════════════════════════════════════════════════════

# ─── Bot Discord (OBLIGATOIRE) ───────────────────────────────────────
TOKEN=ton_token_discord_ici

# ─── Base de données (OBLIGATOIRE) ───────────────────────────────────
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# ─── API / Dashboard (OBLIGATOIRE) ───────────────────────────────────
# Clé secrète longue et aléatoire (min. 32 caractères)
BOT_API_KEY=une_cle_secrete_longue_et_aleatoire

# Doit être identique à BOT_API_KEY — intégré dans le build Vite
VITE_BOT_API_KEY=une_cle_secrete_longue_et_aleatoire

# ─── IA OpenRouter (OBLIGATOIRE pour !ia, bilans IA) ─────────────────
OPENROUTER_API_KEY=sk-or-...

# ─── URL publique du dashboard (RECOMMANDÉ) ──────────────────────────
# L'URL complète de ton hébergement — utilisée par !tableaudebord lien
# Exemple Wispbyte : https://monapp.wispbyte.com
# Exemple Railway  : https://supremyx-bot.up.railway.app
DASHBOARD_URL=https://ton-domaine.wispbyte.com

# ─── Channels Discord (OPTIONNEL) ────────────────────────────────────
# ID du salon où les erreurs critiques du bot sont loguées
LOG_CHANNEL_ID=

# ID du salon des annonces automatiques
ANNOUNCE_CHANNEL_ID=

# ID du salon où les sauvegardes automatiques sont envoyées
BACKUP_CHANNEL_ID=

# ─── Permissions (OPTIONNEL) ─────────────────────────────────────────
# ID Discord du propriétaire du bot (accès commandes admin)
OWNER_ID=

# ─── Notifications Discord (OPTIONNEL) ───────────────────────────────
# Webhook Discord pour les notifications de push GitHub
DISCORD_WEBHOOK_URL=

# ─── Git / GitHub (OPTIONNEL) ────────────────────────────────────────
# Token GitHub pour les commandes !gitpush, !gitstatus, !changelog
GITHUB_TOKEN=

# Répertoire racine du projet (défaut : dossier courant process.cwd())
# Utile uniquement si le process démarre depuis un sous-dossier
# REPO_DIR=/home/container/...

# ─── Port (assigné automatiquement sur Wispbyte) ─────────────────────
# Ne pas définir sur Wispbyte — la plateforme injecte PORT automatiquement
# PORT=3000
