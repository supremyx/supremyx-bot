# ─── Bot Discord ─────────────────────────────────────────────────────────────
TOKEN=ton_token_discord_ici

# ─── Base de données ──────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# ─── API / Dashboard ─────────────────────────────────────────────────────────
# Clé secrète longue et aléatoire (min. 32 caractères)
BOT_API_KEY=une_cle_secrete_longue_et_aleatoire

# ─── IA (OpenRouter) ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...

# ─── Port (optionnel — défaut : 3000) ────────────────────────────────────────
# Sur Wispbyte ce port est assigné automatiquement par la plateforme.
# PORT=3000

# ─── Dashboard (variables Vite — à définir avant le build) ───────────────────
# VITE_BOT_API_KEY doit être identique à BOT_API_KEY
# VITE_BOT_API_KEY=une_cle_secrete_longue_et_aleatoire
