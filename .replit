modules = ["nodejs-20", "bash", "python-3.12", "web"]
[agent]
expertMode = true
stack = "FULLSTACK_JS"
integrations = ["javascript_openai_ai_integrations:2.0.0"]

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 3000
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Discord Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Auto-push GitHub"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "fuser -k 5000/tcp 2>/dev/null; cd dashboard && PORT=5000 BASE_PATH=/ npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Discord Bot"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node index.js"

[[workflows.workflow]]
name = "Auto-push GitHub"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/autopush.sh"

[workflows.workflow.metadata]
outputType = "console"

[deployment]
deploymentTarget = "vm"
build = ["bash", "-c", "npm install --legacy-peer-deps && cd dashboard && npm install --legacy-peer-deps && npm run build"]
publicDir = "dashboard/dist/public"
run = ["node", "index.js"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]
NODE_ENV = "development"
